# ============================================================
# Finans Portalı – .gitignore
# ============================================================

# ── Java / Maven ──────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*

# ── Node / React ──────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
*.sublime-project
*.sublime-workspace

# ── Environment / Secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Docker ────────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── Coverage / Test Reports ──────────────────────────────────
coverage/
*.lcov
surefire-reports/
failsafe-reports/

# ── Misc ──────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig

backend/src/main/resources/application.yml
